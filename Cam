-- 5. SISTEM MACRO (Sama seperti sebelumnya, tapi lebih aman)
local rawFireServer = {
    [TowerAdd]     = TowerAdd.FireServer,
    [TowerUpgrade] = TowerUpgrade.FireServer,
    [TowerSell]    = TowerSell.FireServer,
}

local recordedActions = {}
local isRecording = false
local isPlaying = false
local recordingStartTime = 0
local placeCounter = 0
local serverIdToPlaceIndex = {}
local newServerIdByPlaceIndex = {}
local placeResponseWaiters = {}
local pendingPlaceResponses = {}

TowerAdd.OnClientEvent:Connect(function(...)
    local args = {...}
    local id, unitId
    for i = 1, select("#", ...) do
        local a = args[i]
        if type(a) == "table" then
            if a.Id then id = a.Id end
            if a.UnitId then unitId = a.UnitId end
        end
    end
    if not id then return end

    if #placeResponseWaiters > 0 then
        local w = table.remove(placeResponseWaiters, 1)
        w.resolved = true
        w.id = id
        w.unitId = unitId
    else
        table.insert(pendingPlaceResponses, {id = id, unitId = unitId})
    end
end)

local function copyArg(arg)
    if type(arg) == "table" then
        local c = {}
        for k, v in pairs(arg) do c[k] = copyArg(v) end
        return c
    end
    return arg
end

local function copyArgs(p, n)
    local c = table.create(n)
    for i = 1, n do c[i] = copyArg(p[i]) end
    return c
end

local function shortId(id)
    if not id or #id < 8 then return tostring(id) end
    return id:sub(1, 8)
end

local function getLabel(t)
    if t == "Place" then return "PLACE" end
    if t == "Upgrade" then return "UPGRADE" end
    if t == "Sell" then return "SELL" end
    return t
end

local function describeArg(a)
    local t = typeof(a)
    if t == "table" then return "{...}" 
    elseif t == "string" then return '"'..a..'"'
    else return tostring(a) end
end

local function recordAction(actionType, remote, packedArgs, argCount)
    if not isRecording then return end
    local elapsedTime = os.clock() - recordingStartTime
    local storedArgs = copyArgs(packedArgs, argCount)

    local entry = {
        time = elapsedTime,
        actionType = actionType,
        remoteName = remote.Name,
        args = storedArgs,
        argCount = argCount,
    }

    if actionType == "Place" then
        local uid = (type(storedArgs[1]) == "table" and storedArgs[1].UnitId) or nil
        placeCounter = placeCounter + 1
        entry.placeIndex = placeCounter
        entry.unitId = uid
        queueLog(string.format("REC [%d] PLACE #%d UnitId=%s [t=%.2f]", #recordedActions, placeCounter, shortId(uid), elapsedTime))
    elseif actionType == "Upgrade" or actionType == "Sell" then
        local oldId = (type(storedArgs[1]) == "table" and storedArgs[1].Id) or nil
        local pIdx = oldId and serverIdToPlaceIndex[oldId] or nil
        entry.originalId = oldId
        entry.placeIndex = pIdx
        queueLog(string.format("REC [%d] %s Id=%s -> place#%s [t=%.2f]", #recordedActions, getLabel(actionType), shortId(oldId), tostring(pIdx or "?"), elapsedTime))
    end

    table.insert(recordedActions, entry)
end

-- Direct Hook (Aman dari error executor)
local remotesToHook = {
    { remote = TowerAdd,     actionType = "Place" },
    { remote = TowerUpgrade, actionType = "Upgrade" },
    { remote = TowerSell,    actionType = "Sell" },
}
for _, entry in ipairs(remotesToHook) do
    local rawFire = entry.remote.FireServer
    entry.remote.FireServer = function(self, ...)
        if isRecording then 
            local n = select("#", ...)
            if n > 0 then recordAction(entry.actionType, self, table.pack(...), n) end
        end
        return rawFire(self, ...)
    end
end

-- Playback
local MIN_INTERVAL = 0.2
local remoteByName = { ["TowerAdd"] = TowerAdd, ["TowerUpgrade"] = TowerUpgrade, ["TowerSell"] = TowerSell }

local function waitForPlaceResponse(timeout)
    if #pendingPlaceResponses > 0 then return table.remove(pendingPlaceResponses, 1) end
    local w = {resolved = false, id = nil, unitId = nil}
    table.insert(placeResponseWaiters, w)
    local t0 = os.clock()
    while not w.resolved and (os.clock() - t0) < timeout do task.wait(0.05) end
    if not w.resolved then
        for i, x in ipairs(placeResponseWaiters) do if x == w then table.remove(placeResponseWaiters, i) break end end
        return nil
    end
    return w
end

local function playMacro()
    if isPlaying or #recordedActions == 0 then return end
    isPlaying = true
    StatusLabel.Text = "Status: PLAYING..."
    StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
    queueLog(string.format("PLAYBACK STARTED: %d aksi", #recordedActions))

    task.spawn(function()
        newServerIdByPlaceIndex = {}
        pendingPlaceResponses = {}
        placeResponseWaiters = {}
        local playPlaceCounter = 0
        local playStartTime = os.clock()
        local lastFire = 0

        for index, action in ipairs(recordedActions) do
            if not isPlaying then break end
            local waitDuration = action.time - (os.clock() - playStartTime)
            if waitDuration > 0 then task.wait(waitDuration) end
            local sinceLast = os.clock() - lastFire
            if sinceLast < MIN_INTERVAL then task.wait(MIN_INTERVAL - sinceLast) end
            if not isPlaying then break end

            local remote = remoteByName[action.remoteName]
            local fireArgs = copyArgs(action.args, action.argCount)
            local rawFn = rawFireServer[remote] or remote.FireServer

            if action.actionType == "Place" then
                playPlaceCounter = playPlaceCounter + 1
                local myPlaceIndex = playPlaceCounter
                local sentUnitId = (type(fireArgs[1]) == "table" and fireArgs[1].UnitId) or nil
                
                local ok, err = pcall(function() rawFn(remote, table.unpack(fireArgs, 1, action.argCount)) end)
                if ok then
                    queueLog(string.format("PLAY [%d/%d] PLACE #%d UnitId=%s", index, #recordedActions, myPlaceIndex, shortId(sentUnitId)))
                    local resp = waitForPlaceResponse(3)
                    if resp and resp.id then
                        newServerIdByPlaceIndex[myPlaceIndex] = resp.id
                        queueLog(string.format("   <- server Id: %s", shortId(resp.id)))
                    else
                        queueLog("   ! tidak ada respon server (timeout)")
                    end
                else
                    queueLog(string.format("FAILED [%d] PLACE: %s", index, tostring(err)))
                end
            elseif action.actionType == "Upgrade" or action.actionType == "Sell" then
                local pIdx = action.placeIndex
                if type(fireArgs[1]) == "table" and fireArgs[1].Id then
                    local newId = pIdx and newServerIdByPlaceIndex[pIdx]
                    if newId then
                        local oldId = fireArgs[1].Id
                        fireArgs[1].Id = newId
                        queueLog(string.format("   -> remap Id %s -> %s (place #%d)", shortId(oldId), shortId(newId), pIdx))
                    else
                        queueLog(string.format("   ! tidak ada Id baru untuk place #%s (dilewati)", tostring(pIdx or "?")))
                        goto continue
                    end
                end
                local ok, err = pcall(function() rawFn(remote, table.unpack(fireArgs, 1, action.argCount)) end)
                if ok then
                    queueLog(string.format("PLAY [%d/%d] %s: %s", index, #recordedActions, getLabel(action.actionType), describeArg(fireArgs[1])))
                else
                    queueLog(string.format("FAILED [%d] %s: %s", index, getLabel(action.actionType), tostring(err)))
                end
            end
            ::continue::
            lastFire = os.clock()
        end
        isPlaying = false
        StatusLabel.Text = "Status: IDLE"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        queueLog("PLAYBACK FINISHED")
    end)
end

