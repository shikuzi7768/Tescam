        end
        status.Text = string.format("Status: %s | Actions: %d", txt, #recordedActions)
        gameSpeedBtn.Text = string.format("🎮 Game: %.1fx", currentGameSpeed)
    end

    recBtn.MouseButton1Click:Connect(function()
        if recording then
            recording = false
            recBtn.Text = "⏺ RECORD"
            recBtn.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
            log("RECORD", string.format("⏹ Record selesai. Total %d aksi berhasil terekam.", #recordedActions))
            
            SaveMacroToFile(currentMacroName)
        else
            if playing then return end
            recordedActions = {}
            recordGameTime  = 0
            lastRecordTick  = tick()
            recording       = true
            recBtn.Text     = "⏹ STOP"
            recBtn.BackgroundColor3 = Color3.fromRGB(110, 30, 30)
            log("RECORD", "▶ Recording dimulai...")
        end
        updateStatus()
    end)

    playBtn.MouseButton1Click:Connect(function()
        if playing then
            playing = false
            updateStatus()
            log("PLAY", "⏹ Playback dihentikan.")
        else
            StartPlayback()
        end
    end)

    autoPlayBtn.MouseButton1Click:Connect(function()
        autoPlayEnabled = not autoPlayEnabled
        refreshAutoPlayUI()
        SaveConfig()

        if autoPlayEnabled then
            log("AUTOPLAY", "✅ Auto Play diaktifkan.")
            if #recordedActions == 0 then
                LoadMacroFromFile(currentMacroName)
            end
            if not playing and #recordedActions > 0 then
                StartPlayback()
            end
        else
            log("AUTOPLAY", "⏹ Auto Play dimatikan.")
        end
    end)

    auto2xBtn.MouseButton1Click:Connect(function()
        auto2xSpeedEnabled = not auto2xSpeedEnabled
        if auto2xSpeedEnabled then
            auto3xSpeedEnabled = false
            SetGameSpeed(2.0)
            log("SPEED", "⚡ Auto 2x Game Speed diaktifkan.")
        else
            log("SPEED", "⏹ Auto 2x Game Speed dimatikan.")
        end
        refreshAuto2xUI()
        refreshAuto3xUI()
        SaveConfig()
    end)

    auto3xBtn.MouseButton1Click:Connect(function()
        auto3xSpeedEnabled = not auto3xSpeedEnabled
        if auto3xSpeedEnabled then
            auto2xSpeedEnabled = false
            SetGameSpeed(3.0)
            log("SPEED", "🔥 Auto 3x Game Speed diaktifkan.")
        else
            log("SPEED", "⏹ Auto 3x Game Speed dimatikan.")
        end
        refreshAuto2xUI()
        refreshAuto3xUI()
        SaveConfig()
    end)

    saveBtn.MouseButton1Click:Connect(function()
        SaveMacroToFile(currentMacroName)
    end)

    loadBtn.MouseButton1Click:Connect(function()
        if LoadMacroFromFile(currentMacroName) then
            updateStatus()
            if autoPlayEnabled and not playing then
                StartPlayback()
            end
        end
    end)

    local macroSpeeds = {1.0, 1.25, 1.5, 2.0}
    local macroSpeedIdx = 1
    speedBtn.MouseButton1Click:Connect(function()
        macroSpeedIdx = (macroSpeedIdx % #macroSpeeds) + 1
        playbackSpeed = macroSpeeds[macroSpeedIdx]
        speedBtn.Text = string.format("🚀 Mult: %.2fx", playbackSpeed)
        SaveConfig()
    end)

    local gameSpeeds = {1.0, 1.5, 2.0, 3.0}
    local gameSpeedIdx = 1
    gameSpeedBtn.MouseButton1Click:Connect(function()
        gameSpeedIdx = (gameSpeedIdx % #gameSpeeds) + 1
        local newSpd = gameSpeeds[gameSpeedIdx]
        SetGameSpeed(newSpd)
        SaveConfig()
        updateStatus()
    end)

    clearBtn.MouseButton1Click:Connect(function()
        if recording or playing then return end
        recordedActions = {}
        updateStatus()
        log("UI", "Record dibersihkan.")
    end)

    task.spawn(function()
        while gui and gui.Parent do
            updateStatus()
            task.wait(0.5)
        end
    end)
end

