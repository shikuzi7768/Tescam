local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")

local RemoteFunctions = ReplicatedStorage:WaitForChild("RemoteFunctions")
local PlaceTowerRF    = RemoteFunctions:WaitForChild("PlaceTower")
local SellTowerRF     = RemoteFunctions:WaitForChild("SellTower")
local UpgradeTowerRF  = RemoteFunctions:WaitForChild("UpgradeTower")

--//========== CONFIG ==========
local DEBUG_MODE    = true    -- log semua InvokeServer ke 3 remote
local VERBOSE_HOOK  = true    -- log tiap langkah di recording block (buat diagnosa)
local HOOK_DISABLED = false

--//========== STATE ==========
local recording       = false
local playing         = false
local recordedActions = {}
local recordStartTick = 0
local playStartTick   = 0

--//========== LOGGER ==========
local function log(tag, msg)
    print(string.format("[%s][MACRO][%s] %s", os.date("%H:%M:%S"), tag, msg))
end

--//========== HELPER: CFrame tower — support ALL instance types ==========
local function getTowerCFrame(tower)
    if not tower then return nil end

    -- 1. BasePart langsung
    if tower:IsA("BasePart") then
        return tower.CFrame
    end

    -- 2. Model dengan PrimaryPart
    if tower:IsA("Model") then
        if tower.PrimaryPart then
            return tower.PrimaryPart.CFrame
        end
        local ok, pivot = pcall(function() return tower:GetPivot() end)
        if ok and pivot then
            return pivot
        end
    end

    -- 3. Model / Folder / apapun: cari BasePart descendant
    for _, d in ipairs(tower:GetDescendants()) do
        if d:IsA("BasePart") then
            return d.CFrame
        end
    end

    return nil
end

--//========== HELPER: Cari tower saat playback ==========
local function findTowerInstance(name, targetCFrame)
    if not targetCFrame then return nil end
    local best, bestDist = nil, math.huge
    pcall(function()
        for _, obj in ipairs(getnilinstances()) do
            if obj.Name == name then
                local pos = getTowerCFrame(obj)
                if pos then
                    local dist = (pos.Position - targetCFrame.Position).Magnitude
                    if dist < bestDist then
                        best, bestDist = obj, dist
                    end
                end
            end
        end
    end)
    if best and bestDist <= 15 then
        return best, bestDist
    end
    return nil
end

--//========== HOOK ==========
if not HOOK_DISABLED then
    local oldNamecall
    local ok_hook, err_hook = pcall(function()
        local mt = getrawmetatable(game)
        oldNamecall = mt.__namecall
        if setreadonly then setreadonly(mt, false) end

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()

            -- Identifikasi remote
            local targetName = nil
            if self == PlaceTowerRF then targetName = "PlaceTower"
            elseif self == SellTowerRF then targetName = "SellTower"
            elseif self == UpgradeTowerRF then targetName = "UpgradeTower" end

            -- Semua logic di bawah ini dibungkus pcall
            -- Supaya error tidak pernah block panggilan asli
            if targetName and method == "InvokeServer" then
                pcall(function()
                    local args = {...}

                    -- DBG: log semua InvokeServer ke target remote
                    if DEBUG_MODE then
                        local parts = {}
                        for i, a in ipairs(args) do
                            local s = tostring(a)
                            if #s > 50 then s = s:sub(1, 47) .. "..." end
                            table.insert(parts, string.format("#%d<%s>=%s",
                                i, typeof(a), s))
                        end
                        log("DBG", string.format("%s:InvokeServer(%s, recording=%s)",
                            targetName, table.concat(parts, ", "),
                            tostring(recording)))
                    end

                    -- Recording logic
                    if recording then
                        local t = tick() - recordStartTick

                        if targetName == "PlaceTower" then
                            local towerName, cframe = args[1], args[2]
                            if VERBOSE_HOOK then
                                log("V", string.format(
                                    "Place: #1 typeof=%s, #2 typeof=%s",
                                    typeof(towerName), typeof(cframe)))
                            end
                            if typeof(cframe) == "CFrame" and type(towerName) == "string" then
                                table.insert(recordedActions, {
                                    type = "place", time = t,
                                    towerName = towerName, cframe = cframe,
                                })
                                log("RECORD", string.format(
                                    "#%d PLACE '%s' @ T=%.3fs | Pos=(%.1f, %.1f, %.1f)",
                                    #recordedActions, towerName, t,
                                    cframe.Position.X, cframe.Position.Y, cframe.Position.Z))
                            else
                                log("RECORD", "⚠ Place arg tidak valid, skip")
                            end

                        elseif targetName == "UpgradeTower" or targetName == "SellTower" then
                            local actionType = (targetName == "UpgradeTower"
                                and "upgrade" or "sell")
                            local tower = args[1]

                            if VERBOSE_HOOK then
                                log("V", string.format(
                                    "%s: arg count=%d, #1 typeof=%s",
                                    targetName, #args, typeof(tower)))
                            end

                            -- Cek Instance — pakai dua cara
                            local isInstance = typeof(tower) == "Instance"
                            if not isInstance then
                                -- Fallback: cek apakah punya property khas Instance
                                local ok_check = pcall(function()
                                    local _ = tower.Name
                                    local _ = tower.ClassName
                                    isInstance = true
                                end)
                            end

                            if isInstance then
                                local name    = tower.Name
                                local class   = tower.ClassName
                                local cf      = getTowerCFrame(tower)

                                if VERBOSE_HOOK then
                                    log("V", string.format(
                                        "  Instance OK: Name='%s' Class='%s' CF=%s",
                                        name, class, tostring(cf ~= nil)))
                                end

                                if cf then
                                    table.insert(recordedActions, {
                                        type = actionType, time = t,
                                        towerName = name, towerCFrame = cf,
                                    })
                                    log("RECORD", string.format(
                                        "#%d %s '%s' (Class=%s) @ T=%.3fs | Pos=(%.1f, %.1f, %.1f)",
                                        #recordedActions, string.upper(actionType),
                                        name, class, t,
                                        cf.Position.X, cf.Position.Y, cf.Position.Z))
                                else
                                    log("RECORD", string.format(
                                        "⚠ Tidak bisa ambil CFrame dari '%s' (Class=%s)",
                                        name, class))
                                end
                            else
                                log("RECORD", string.format(
                                    "⚠ Arg bukan Instance (typeof=%s), skip",
                                    typeof(tower)))
                            end
                        end
                    end
                end)  -- end pcall
            end

            -- WAJIB: forward ke original namecall
            return oldNamecall(self, ...)
        end)

        if setreadonly then setreadonly(mt, true) end
    end)

    if ok_hook then
        log("INIT", "Hook __namecall terpasang.")
    else
        log("INIT", "❌ HOOK GAGAL: " .. tostring(err_hook))
    end
end

--//========== RECORD / PLAY ==========
local function startRecord()
    if playing or recording then return end
    recordedActions = {}
    recordStartTick = tick()
    recording = true
    log("RECORD", "▶ Recording dimulai.")
end

local function stopRecord()
    if not recording then return end
    recording = false
    log("RECORD", string.format("⏹ Recording dihentikan. %d aksi.", #recordedActions))
end

local function stopPlay()
    if not playing then return end
    playing = false
    log("PLAY", "⏹ Playback dihentikan.")
end

-- Format argumen untuk Sell/Upgrade
local function tryInvoke(remote, action, label)
    local tower, dist = findTowerInstance(action.towerName, action.towerCFrame)
    if not tower then
        return false, string.format("Tower '%s' tidak ditemukan", action.towerName)
    end

    local candidates = {
        { name = "Instance", value = tower },
        { name = "DebugId",  value = tower:GetDebugId() },
        { name = "Name",     value = tower.Name },
    }
    for _, child in ipairs(tower:GetDescendants()) do
        if child:IsA("StringValue") then
            table.insert(candidates, {
                name = "StrVal:" .. child.Name, value = child.Value,
            })
        end
    end

    local lastErr
    for _, cand in ipairs(candidates) do
        local ok, err = pcall(function() remote:InvokeServer(cand.value) end)
        if ok then
            return true, string.format("%s '%s' via %s (dist=%.2f)",
                label, action.towerName, cand.name, dist)
        end
        lastErr = err
        log("TRY", string.format("  Format %s gagal: %s", cand.name, tostring(err)))
    end
    return false, "Semua format gagal. Error terakhir: " .. tostring(lastErr)
end

local function executeAction(action)
    if action.type == "place" then
        PlaceTowerRF:InvokeServer(action.towerName, action.cframe)
        return true, string.format("PLACE '%s' | (%.1f, %.1f, %.1f)",
            action.towerName,
            action.cframe.Position.X, action.cframe.Position.Y, action.cframe.Position.Z)
    elseif action.type == "upgrade" then
        return tryInvoke(UpgradeTowerRF, action, "UPGRADE")
    elseif action.type == "sell" then
        return tryInvoke(SellTowerRF, action, "SELL")
    end
    return false, "Tipe tidak dikenal: " .. tostring(action.type)
end

local function startPlay()
    if recording or playing then return end
    if #recordedActions == 0 then log("PLAY", "Tidak ada aksi.") return end
    playing = true
    playStartTick = tick()
    log("PLAY", string.format("▶ Playback dimulai. %d aksi...", #recordedActions))

    task.spawn(function()
        for i, action in ipairs(recordedActions) do
            if not playing then break end
            local waitTime = action.time - (tick() - playStartTick)
            if waitTime > 0 then task.wait(waitTime) end
            if not playing then break end

            local ok, msg = pcall(executeAction, action)
            if ok and msg then
                log("PLAY", string.format("[%d/%d] %s", i, #recordedActions, msg))
            else
                log("PLAY", string.format("[%d/%d] ❌ GAGAL: %s",
                    i, #recordedActions, tostring(msg)))
            end
        end
        playing = false
        log("PLAY", "✅ Playback selesai.")
    end)
end

