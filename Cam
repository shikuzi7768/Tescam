--//========== AMBIL POSISI INSTANCE (MENCEGAH TOWER/ABILITY TERTUKAR) ==========
local function GetInstancePosition(inst)
    local pos = nil
    pcall(function()
        if typeof(inst) == "Instance" then
            if inst:IsA("Model") then
                local p = inst:GetPivot().Position
                pos = { x = p.X, y = p.Y, z = p.Z }
            elseif inst:IsA("BasePart") then
                local p = inst.Position
                pos = { x = p.X, y = p.Y, z = p.Z }
            end
        end
    end)
    return pos
end

--//========== SERIALISASI TIPE DATA ROBLOX ==========
local function SerializeVal(v)
    local t = typeof(v)
    if t == "Instance" then
        local pos = GetInstancePosition(v)
        return { __type = "Instance", path = v:GetFullName(), name = v.Name, pos = pos }
    elseif t == "Vector3" then
        return { __type = "Vector3", x = v.X, y = v.Y, z = v.Z }
    elseif t == "CFrame" then
        return { __type = "CFrame", components = { v:GetComponents() } }
    elseif t == "Color3" then
        return { __type = "Color3", r = v.R, g = v.G, b = v.B }
    elseif t == "Vector2" then
        return { __type = "Vector2", x = v.X, y = v.Y }
    elseif t == "EnumItem" then
        return { __type = "EnumItem", enum = tostring(v.EnumType), item = v.Name }
    elseif t == "table" then
        local tCopy = {}
        for k, val in pairs(v) do
            tCopy[k] = SerializeVal(val)
        end
        return tCopy
    else
        return v
    end
end

local function SerializeArgs(args)
    local serialized = {}
    for i, v in ipairs(args) do
        serialized[i] = SerializeVal(v)
    end
    return serialized
end

--//========== RESOLVE INSTANCE BERBASIS SPATIAL (NEAREST POSITION) ==========
local function ResolveInstance(path, name, posData)
    if posData and type(posData) == "table" then
        local targetPos = Vector3.new(posData.x or 0, posData.y or 0, posData.z or 0)
        local closestObj = nil
        local shortestDist = math.huge

        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc.Name == name then
                local p = nil
                pcall(function()
                    if desc:IsA("Model") then
                        p = desc:GetPivot().Position
                    elseif desc:IsA("BasePart") then
                        p = desc.Position
                    end
                end)
                if p then
                    local dist = (p - targetPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestObj = desc
                    end
                end
            end
        end

        if closestObj and shortestDist < 10.0 then
            return closestObj
        end
    end

    local obj = workspace
    for segment in string.gmatch(path or "", "[^.]+") do
        if segment ~= "Workspace" and segment ~= "game" then
            obj = obj:FindFirstChild(segment)
            if not obj then break end
        end
    end
    return obj or workspace:FindFirstChild(name or "", true)
end

local function DeserializeVal(v)
    if type(v) == "table" then
        if v.__type == "Instance" then
            return ResolveInstance(v.path, v.name, v.pos)
        elseif v.__type == "Vector3" then
            return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
        elseif v.__type == "CFrame" and v.components then
            return CFrame.new(unpack(v.components))
        elseif v.__type == "Color3" then
            return Color3.new(v.r or 0, v.g or 0, v.b or 0)
        elseif v.__type == "Vector2" then
            return Vector2.new(v.x or 0, v.y or 0)
        elseif v.__type == "EnumItem" then
            local enumGroup = Enum[v.enum]
            if enumGroup and enumGroup[v.item] then
                return enumGroup[v.item]
            end
            return nil
        else
            local tCopy = {}
            for k, val in pairs(v) do
                tCopy[k] = DeserializeVal(val)
            end
            return tCopy
        end
    end
    return v
end

local function DeserializeArgs(args)
    local deserialized = {}
    for i, v in ipairs(args) do
        deserialized[i] = DeserializeVal(v)
    end
    return deserialized
end

