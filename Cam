local function GetFileName(profileName)
    local cleanName = string.gsub(profileName, "[%s%c%p]", "_")
    return "TD_Macro_" .. cleanName .. ".json"
end

local function GetRemoteByName(name)
    for _, v in ipairs(game:GetDescendants()) do
        if v.Name == name and (v:IsA("RemoteFunction") or v:IsA("RemoteEvent")) then
            return v
        end
    end
    return nil
end

local function SetGameSpeed(speed)
    currentGameSpeed = speed
    pcall(function()
        local speedRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("SetGameSpeed")
        if speedRemote then
            speedRemote:FireServer(speed)
            log("GAME", string.format("⚡ Kecepatan game diatur ke x%.1f", speed))
        end
    end)
end

--//========== SERIALISASI TIPE DATA ROBLOX (VECTOR3, CFRAME, INSTANCE, ENUM) ==========
local function SerializeVal(v)
    local t = typeof(v)
    if t == "Instance" then
        return { __type = "Instance", path = v:GetFullName(), name = v.Name }
    elseif t == "Vector3" then
        return { __type = "Vector3", x = v.X, y = v.Y, z = v.Z }
    elseif t == "CFrame" then
        return { __type = "CFrame", components = { v:GetComponents() } }
    elseif t == "Color3" then
        return { __type = "Color3", r = v.R, g = v.G, b = v.B }
    elseif t == "Vector2" then
        return { __type = "Vector2", x = v.X, y = v.Y }
    elseif t == "EnumItem" then
        return { __type = "EnumItem", enum = tostring(v.EnumType), item = v.Name }
    elseif t == "table" then
        local tCopy = {}
        for k, val in pairs(v) do
            tCopy[k] = SerializeVal(val)
        end
        return tCopy
    else
        return v
    end
end

local function SerializeArgs(args)
    local serialized = {}
    for i, v in ipairs(args) do
        serialized[i] = SerializeVal(v)
    end
    return serialized
end

local function ResolveInstance(path, name)
    local obj = workspace
    for segment in string.gmatch(path or "", "[^.]+") do
        if segment ~= "Workspace" and segment ~= "game" then
            obj = obj:FindFirstChild(segment)
            if not obj then break end
        end
    end
    return obj or workspace:FindFirstChild(name or "", true)
end

