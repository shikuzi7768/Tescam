end

--//========== SERIALISASI TIPE DATA ROBLOX (VECTOR3, CFRAME, INSTANCE, ENUM) ==========
local function SerializeVal(v)
    local t = typeof(v)
    if t == "Instance" then
        return { __type = "Instance", path = v:GetFullName(), name = v.Name }
    elseif t == "Vector3" then
        return { __type = "Vector3", x = v.X, y = v.Y, z = v.Z }
    elseif t == "CFrame" then
        return { __type = "CFrame", components = { v:GetComponents() } }
    elseif t == "Color3" then
        return { __type = "Color3", r = v.R, g = v.G, b = v.B }
    elseif t == "Vector2" then
        return { __type = "Vector2", x = v.X, y = v.Y }
    elseif t == "EnumItem" then
        return { __type = "EnumItem", enum = tostring(v.EnumType), item = v.Name }
    elseif t == "table" then
        local tCopy = {}
        for k, val in pairs(v) do
            tCopy[k] = SerializeVal(val)
        end
        return tCopy
    else
        return v
    end
end

local function SerializeArgs(args)
    local serialized = {}
    for i, v in ipairs(args) do
        serialized[i] = SerializeVal(v)
    end
    return serialized
end

local function ResolveInstance(path, name)
    local obj = workspace
    for segment in string.gmatch(path or "", "[^.]+") do
        if segment ~= "Workspace" and segment ~= "game" then
            obj = obj:FindFirstChild(segment)
            if not obj then break end
        end
    end
    return obj or workspace:FindFirstChild(name or "", true)
end

local function DeserializeVal(v)
    if type(v) == "table" then
        if v.__type == "Instance" then
            return ResolveInstance(v.path, v.name)
        elseif v.__type == "Vector3" then
            return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
        elseif v.__type == "CFrame" and v.components then
            return CFrame.new(unpack(v.components))
        elseif v.__type == "Color3" then
            return Color3.new(v.r or 0, v.g or 0, v.b or 0)
        elseif v.__type == "Vector2" then
            return Vector2.new(v.x or 0, v.y or 0)
        elseif v.__type == "EnumItem" then
            local enumGroup = Enum[v.enum]
            if enumGroup and enumGroup[v.item] then
                return enumGroup[v.item]
            end
            return nil
        else
            local tCopy = {}
            for k, val in pairs(v) do
                tCopy[k] = DeserializeVal(val)
            end
            return tCopy
        end
    end
    return v
end

local function DeserializeArgs(args)
    local deserialized = {}
    for i, v in ipairs(args) do
        deserialized[i] = DeserializeVal(v)
    end
    return deserialized
end

--//========== SISTEM SAVING CONFIG & FILE ==========
local function SaveConfig()
    if not writefile then return end
    pcall(function()
        local cfg = {
            autoPlay         = autoPlayEnabled,
            auto2xSpeed      = auto2xSpeedEnabled,
            auto3xSpeed      = auto3xSpeedEnabled,
            autoSummon       = autoSummonEnabled,
            autoSpin         = autoSpinEnabled,
            lastMacroName    = currentMacroName,
            playbackSpeed    = playbackSpeed,
            currentGameSpeed = currentGameSpeed
        }
        writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
        log("CONFIG", "💾 Konfigurasi makro berhasil diperbarui.")
    end)
end

local function LoadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local data = HttpService:JSONEncode(readfile(CONFIG_FILE)) -- decode
        local parsed = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if parsed then
            if parsed.autoPlay ~= nil then autoPlayEnabled = parsed.autoPlay end
            if parsed.auto2xSpeed ~= nil then auto2xSpeedEnabled = parsed.auto2xSpeed end
            if parsed.auto3xSpeed ~= nil then auto3xSpeedEnabled = parsed.auto3xSpeed end
            if parsed.autoSummon ~= nil then autoSummonEnabled = parsed.autoSummon end
            if parsed.autoSpin ~= nil then autoSpinEnabled = parsed.autoSpin end
            if parsed.lastMacroName then currentMacroName = parsed.lastMacroName end
            if parsed.playbackSpeed then playbackSpeed = parsed.playbackSpeed end
            if parsed.currentGameSpeed then currentGameSpeed = parsed.currentGameSpeed end
            log("CONFIG", "📂 Konfigurasi tersimpan berhasil dimuat.")
        end
    end)
end

local function SaveMacroToFile(name)
    if #recordedActions == 0 then
        return log("SAVE", "⚠️ Tidak ada aksi untuk disimpan!")
    end
    if not writefile then
        return log("SAVE", "❌ Executor tidak mendukung writefile!")
    end

    local fileName = GetFileName(name)
    local cleanActions = {}
    for _, act in ipairs(recordedActions) do
        table.insert(cleanActions, {
            remoteName  = act.remoteName,
            remoteClass = act.remoteClass,
            args        = act.args,
            gameTime    = act.gameTime
        })
    end

    local ok, err = pcall(function()
        writefile(fileName, HttpService:JSONEncode(cleanActions))
    end)

    if ok then
        log("SAVE", string.format("💾 Profil '%s' disimpan ke '%s' (%d aksi)", name, fileName, #recordedActions))
        SaveConfig()
    else
        log("SAVE", "❌ Gagal menyimpan file makro: " .. tostring(err))
    end
end

local function LoadMacroFromFile(name)
    if not readfile or not isfile then
        return log("LOAD", "❌ Executor tidak mendukung readfile/isfile!")
    end

    local fileName = GetFileName(name)
    if not isfile(fileName) then
        return log("LOAD", "⚠️ File makro '" .. fileName .. "' tidak ditemukan!")
    end

    local okParse, parsedData = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)

    if okParse and type(parsedData) == "table" then
        recordedActions = {}
        for _, act in ipairs(parsedData) do
            table.insert(recordedActions, {
                remote      = GetRemoteByName(act.remoteName),
                remoteName  = act.remoteName,
                remoteClass = act.remoteClass,
                args        = act.args,
                gameTime    = act.gameTime or act.time or 0
            })
        end
        log("LOAD", string.format("📂 Profil '%s' dimuat (%d aksi)", name, #recordedActions))
        return true
    else
        log("LOAD", "❌ Gagal membaca file makro!")
        return false
    end
end

--//========== PROSES PLAYBACK TERURUT ==========
local function StartPlayback()
    if recording or #recordedActions == 0 or playing then return end
    playing = true

    if auto3xSpeedEnabled then
        SetGameSpeed(3.0)
    elseif auto2xSpeedEnabled then
        SetGameSpeed(2.0)
    end

    task.spawn(function()
        log("PLAY", string.format("▶ Memulai '%s' [Strict Sequential & Extended Retry]...", currentMacroName))

        local playElapsedGameTime = 0
        local lastPlayTick = tick()

        for i, act in ipairs(recordedActions) do
            if not playing then break end

            local targetGameTime = act.gameTime

            while playing do
                local now = tick()
                local dt = now - lastPlayTick
                lastPlayTick = now

                local effectiveSpeed = currentGameSpeed * playbackSpeed
                playElapsedGameTime = playElapsedGameTime + (dt * effectiveSpeed)

                local remainingGameTime = targetGameTime - playElapsedGameTime
                if remainingGameTime <= 0 then break end

                local realWait = remainingGameTime / effectiveSpeed
                task.wait(math.min(realWait, 0.03))
            end

            if not playing then break end

            local actionSuccess = false
            local retryAttempts = 0

            repeat
                if not playing then break end

                local remoteObj = act.remote or GetRemoteByName(act.remoteName)
                if remoteObj then
                    local realArgs = DeserializeArgs(act.args)
                    
                    local isEvent = remoteObj:IsA("RemoteEvent") or act.remoteClass == "RemoteEvent"
                    local ok, response

                    if isEvent then
                        ok, response = pcall(function()
                            remoteObj:FireServer(unpack(realArgs))
                        end)
                        if ok then actionSuccess = true end
                    else
                        ok, response = pcall(function()
                            return remoteObj:InvokeServer(unpack(realArgs))
                        end)
                        if ok then
                            if response == false or (type(response) == "table" and response.Success == false) then
                                actionSuccess = false
                            else
                                actionSuccess = true
                            end
                        else
                            actionSuccess = false
                        end
                    end
                end

                if not actionSuccess then
                    retryAttempts = retryAttempts + 1
                    log("PLAY", string.format("⚠️ Aksi [%d/%d] '%s' belum berhasil (Mencoba ulang #%d)...", 
                        i, #recordedActions, act.remoteName, retryAttempts))
                    task.wait(0.5 / (currentGameSpeed * playbackSpeed))
                end
            until actionSuccess or not playing

            if actionSuccess then
                log("PLAY", string.format("✅ [%d/%d] Berhasil: %s", i, #recordedActions, act.remoteName))
            end
        end

        playing = false
        log("PLAY", "✅ Playback Makro Selesai.")
    end)
end

