--//========== HOOK INTERCEPTOR AUTOMATIS (DENGAN VALIDASI SUCCESS) ==========
task.spawn(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if (method == "FireServer" or method == "fireServer") and self.Name == "SetGameSpeed" then
            if type(args[1]) == "number" then
                currentGameSpeed = args[1]
                log("GAME", string.format("Terdeteksi perubahan kecepatan game: x%.1f", currentGameSpeed))
            end
        end

        if recording and typeof(self) == "Instance" and (method == "InvokeServer" or method == "invokeServer") then
            if TARGET_REMOTES[self.Name] then
                -- Jalankan remote terlebih dahulu di server untuk mengetahui hasilnya
                local results = { oldNamecall(self, ...) }
                local res = results[1]

                -- Evaluasi keberhasilan respon
                local isSuccess = true
                if res == false or (type(res) == "table" and res.Success == false) then
                    isSuccess = false
                end

                -- Hanya rekam jika server mengonfirmasi aksi berhasil
                if isSuccess then
                    local now = tick()
                    local dt = now - lastRecordTick
                    lastRecordTick = now

                    recordGameTime = recordGameTime + (dt * currentGameSpeed)
                    local currentT = recordGameTime

                    task.spawn(function()
                        pcall(function()
                            local sArgs = SerializeArgs(args)
                            table.insert(recordedActions, {
                                remote     = self,
                                remoteName = self.Name,
                                args       = sArgs,
                                gameTime   = currentT
                            })
                            log("RECORD", string.format("#%d Terekam: '%s' | T_game=%.2fs", 
                                #recordedActions, self.Name, currentT))
                        end)
                    end)
                else
                    log("RECORD", string.format("⚠️ Aksi '%s' diabaikan karena gagal di server (Mencoba ulang saat merekam?).", self.Name))
                end

                return unpack(results)
            end
        end

        return oldNamecall(self, ...)
    end))
end)

