        local UIS = game:GetService("UserInputService")
        local mouse = Players.LocalPlayer:GetMouse()

        -- Tunggu 3 detik, ambil target mouse
        task.wait(3)
        local target = mouse.Target
        if not target then
            log("INSPECT", "Tidak ada objek di bawah kursor.")
            return
        end

        log("INSPECT", "Target: " .. target:GetFullName())
        log("INSPECT", "  ClassName: " .. target.ClassName)

        -- Naik ke parent untuk cari "tower root"
        local current = target
        local depth = 0
        while current and depth < 6 do
            log("INSPECT", string.format("  [Depth %d] %s | Name='%s' | Class='%s' | Children=%d",
                depth, current:GetFullName(), current.Name,
                current.ClassName, #current:GetChildren()))
            current = current.Parent
            depth = depth + 1
        end

        -- Cek apakah ada StringValue di dalam tower
        log("INSPECT", "  -- Mencari StringValue --")
        for _, d in ipairs(target:GetDescendants()) do
