local function SaveMacroToFile(name)
    if #recordedActions == 0 then
        return log("SAVE", "⚠️ Tidak ada aksi berhasil untuk disimpan!")
    end
    if not writefile then
        return log("SAVE", "❌ Executor tidak mendukung writefile!")
    end

    local fileName = GetFileName(name)
    local cleanActions = {}
    for _, act in ipairs(recordedActions) do
        table.insert(cleanActions, {
            remoteName  = act.remoteName,
            remoteClass = act.remoteClass,
            args        = act.args,
            actionIndex = act.actionIndex
        })
    end

    local ok, err = pcall(function()
        writefile(fileName, HttpService:JSONEncode(cleanActions))
    end)

    if ok then
        log("SAVE", string.format("💾 Profil '%s' disimpan ke '%s' (%d aksi sukses)", name, fileName, #recordedActions))
        SaveConfig()
    else
        log("SAVE", "❌ Gagal menyimpan file makro: " .. tostring(err))
    end
end

local function LoadMacroFromFile(name)
    if not readfile or not isfile then
        return log("LOAD", "❌ Executor tidak mendukung readfile/isfile!")
    end

    local fileName = GetFileName(name)
    if not isfile(fileName) then
        return log("LOAD", "⚠️ File makro '" .. fileName .. "' tidak ditemukan!")
    end

    local okParse, parsedData = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)

    if okParse and type(parsedData) == "table" then
        recordedActions = {}
        for _, act in ipairs(parsedData) do
            table.insert(recordedActions, {
                remote      = GetRemoteByName(act.remoteName),
                remoteName  = act.remoteName,
                remoteClass = act.remoteClass,
                args        = act.args,
                actionIndex = act.actionIndex or 1
            })
        end
        log("LOAD", string.format("📂 Profil '%s' dimuat (%d aksi)", name, #recordedActions))
        return true
    else
        log("LOAD", "❌ Gagal membaca file makro!")
        return false
    end
end

--//========== PROSES PLAYBACK BERBASIS CASH & STRICT BLOCKING ==========
local function StartPlayback()
    if recording or #recordedActions == 0 or playing then return end
    playing = true

    if auto4_5xSpeedEnabled then
        SetGameSpeed(4.5)
    elseif auto3_5xSpeedEnabled then
        SetGameSpeed(3.5)
    elseif auto3xSpeedEnabled then
        SetGameSpeed(3.0)
    elseif auto2_5xSpeedEnabled then
        SetGameSpeed(2.5)
    elseif auto2xSpeedEnabled then
        SetGameSpeed(2.0)
    end

    task.spawn(function()
        log("PLAY", string.format("▶ Memulai '%s' v1.2.5 [Cash-Based & Strict Sequential]...", currentMacroName))

        for i, act in ipairs(recordedActions) do
            if not playing then break end

            local actionSuccess = false
            local retryAttempts = 0
            local idxStr = act.actionIndex and (" #" .. act.actionIndex) or ""

            repeat
                if not playing then break end

                local remoteObj = act.remote or GetRemoteByName(act.remoteName)
                if remoteObj then
                    local realArgs = DeserializeArgs(act.args)
                    local isEvent = remoteObj:IsA("RemoteEvent") or act.remoteClass == "RemoteEvent"
                    local ok, response

                    if isEvent then
                        ok, response = pcall(function()
                            remoteObj:FireServer(unpack(realArgs))
                        end)
                        if ok then actionSuccess = true end
                    else
                        ok, response = pcall(function()
                            return remoteObj:InvokeServer(unpack(realArgs))
                        end)
                        if ok then
                            if response == false or (type(response) == "table" and response.Success == false) then
                                actionSuccess = false
                            else
                                actionSuccess = true
                            end
                        else
                            actionSuccess = false
                        end
                    end
                end

                if not actionSuccess then
                    retryAttempts = retryAttempts + 1
                    task.wait(0.2)
                end
            until actionSuccess or not playing

            if not playing then break end

            if actionSuccess then
                log("PLAY", string.format("✅ [%d/%d] Sukses dieksekusi: %s%s", i, #recordedActions, act.remoteName, idxStr))
                task.wait(0.05)
            end
        end

        playing = false
        log("PLAY", "✅ Playback Makro v1.2.5 Selesai.")
    end)
end

