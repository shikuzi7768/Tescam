-- 4. CARI REMOTE DENGAN AMAN (LOOPING)
local TowerAdd, TowerUpgrade, TowerSell
local attempts = 0
while not TowerAdd and attempts < 30 do
    attempts = attempts + 1
    local ml = ReplicatedStorage:FindFirstChild("ModuleLoader")
    if ml then
        local shared = ml:FindFirstChild("Shared")
        if shared then
            local network = shared:FindFirstChild("Network")
            if network then
                local remoteEvent = network:FindFirstChild("RemoteEvent")
                if remoteEvent then
                    TowerAdd = remoteEvent:FindFirstChild("TowerAdd")
                    TowerUpgrade = remoteEvent:FindFirstChild("TowerUpgrade")
                    TowerSell = remoteEvent:FindFirstChild("TowerSell")
                end
            end
        end
    end
    if not TowerAdd then task.wait(1) end
end

if not TowerAdd or not TowerUpgrade or not TowerSell then
    StatusLabel.Text = "Status: ERROR - Remote tidak ditemukan!"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    queueLog("GAGAL: Struktur remote tidak ditemukan di ReplicatedStorage.")
    return
end

