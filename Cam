--//========== HOOK INTERCEPTOR ==========
task.spawn(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if (method == "FireServer" or method == "fireServer") and self.Name == "SetGameSpeed" then
            if type(args[1]) == "number" then
                currentGameSpeed = args[1]
            end
        end

        if recording and typeof(self) == "Instance" and TARGET_REMOTES[self.Name] then
            if method == "InvokeServer" or method == "invokeServer" or method == "FireServer" or method == "fireServer" then
                local results = { oldNamecall(self, ...) }
                local res = results[1]

                local isSuccess = true
                if res == false or (type(res) == "table" and res.Success == false) then
                    isSuccess = false
                end

                if isSuccess then
                    task.spawn(function()
                        pcall(function()
                            if not _G.MacroActionCounters then _G.MacroActionCounters = {} end
                            _G.MacroActionCounters[self.Name] = (_G.MacroActionCounters[self.Name] or 0) + 1
                            local currentActionIdx = _G.MacroActionCounters[self.Name]

                            local sArgs = SerializeArgs(args)
                            table.insert(recordedActions, {
                                remote      = self,
                                remoteName  = self.Name,
                                remoteClass = self.ClassName,
                                args        = sArgs,
                                actionIndex = currentActionIdx
                            })
                            log("RECORD", string.format("✅ Berhasil Terekam [#%d] (%s #%d)", 
                                #recordedActions, self.Name, currentActionIdx))
                        end)
                    end)
                end

                return unpack(results)
            end
        end

        return oldNamecall(self, ...)
    end))
end)

