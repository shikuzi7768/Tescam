-- --------------------------------------------------------------------
-- LISTENER: Server -> Client (TowerAdd) untuk dapat Id server
-- --------------------------------------------------------------------
TowerAdd.OnClientEvent:Connect(function(...)
    local args = {...}
    local n = select("#", ...)
    if n == 0 then return end

    local id, unitId
    for i = 1, n do
        local a = args[i]
        if type(a) == "table" then
            if a.Id then id = a.Id end
            if a.UnitId then unitId = a.UnitId end
        end
    end
    if not id then return end

    -- Beritahu waiter playback (jika ada)
    if #placeResponseWaiters > 0 then
        local w = table.remove(placeResponseWaiters, 1)
        w.resolved = true
        w.id = id
        w.unitId = unitId
    else
        -- Kalau tidak ada waiter, simpan ke pending (untuk race condition)
        table.insert(pendingPlaceResponses, {id = id, unitId = unitId})
    end
end)

-- --------------------------------------------------------------------
-- HELPER
-- --------------------------------------------------------------------
local function describeArg(a, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    local t = typeof(a)
    if t == "CFrame" then return string.format("CFrame(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z)
    elseif t == "Vector3" then return string.format("V3(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z)
    elseif t == "table" then
        local parts = {}
        for k, v in pairs(a) do table.insert(parts, tostring(k).."="..describeArg(v, depth+1)) end
        return "{" .. table.concat(parts, ", ") .. "}"
    elseif t == "string" then
        if #a > 30 then return '"'..a:sub(1,8)..'...'..a:sub(-4)..'"' end
        return '"'..a..'"'
    else return tostring(a) end
end

local function getLabel(t)
    if t == "Place" then return "PLACE" end
    if t == "Upgrade" then return "UPGRADE" end
    if t == "Sell" then return "SELL" end
    return t
end

local function copyArg(arg)
    if type(arg) == "table" then
        local c = {}
        for k, v in pairs(arg) do c[k] = copyArg(v) end
        return c
    end
    return arg
end

local function copyArgs(p, n)
    local c = table.create(n)
    for i = 1, n do c[i] = copyArg(p[i]) end
    return c
end

local function shortId(id)
    if not id or #id < 8 then return tostring(id) end
    return id:sub(1, 8)
end

-- --------------------------------------------------------------------
-- HOOK RECORD
-- --------------------------------------------------------------------
local function recordAction(actionType, remote, packedArgs, argCount)
    if not isRecording then return end
    local elapsedTime = os.clock() - recordingStartTime
    local storedArgs = copyArgs(packedArgs, argCount)

    local entry = {
        time = elapsedTime,
        actionType = actionType,
        remoteName = remote.Name,
        args = storedArgs,
        argCount = argCount,
    }

    if actionType == "Place" then
        -- Catat UnitId untuk place ini
        local uid
        if type(storedArgs[1]) == "table" and storedArgs[1].UnitId then
            uid = storedArgs[1].UnitId
        end
        placeCounter = placeCounter + 1
        entry.placeIndex = placeCounter
        entry.unitId = uid
        queueLog(string.format("REC [%d] PLACE #%d UnitId=%s [t=%.2f]",
            #recordedActions, placeCounter, shortId(uid), elapsedTime))

    elseif actionType == "Upgrade" or actionType == "Sell" then
        -- Cari placeIndex dari Id server yang kita kirim
        local oldId
        if type(storedArgs[1]) == "table" and storedArgs[1].Id then
            oldId = storedArgs[1].Id
        end
        local pIdx = oldId and serverIdToPlaceIndex[oldId] or nil
        entry.originalId = oldId
        entry.placeIndex = pIdx
        queueLog(string.format("REC [%d] %s Id=%s -> place#%s [t=%.2f]",
            #recordedActions, getLabel(actionType), shortId(oldId), tostring(pIdx or "?"), elapsedTime))
    end

    table.insert(recordedActions, entry)
end

local function handleFireServer(remote, actionType, ...)
    local n = select("#", ...)
    if n == 0 then return end
    local packed = table.pack(...)
    recordAction(actionType, remote, packed, n)
end

local hookSuccess = false
local oldNamecall

if hookmetamethod and newcclosure then
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "fireServer") and isRecording then
            if self == TowerAdd then handleFireServer(self, "Place", ...)
            elseif self == TowerUpgrade then handleFireServer(self, "Upgrade", ...)
            elseif self == TowerSell then handleFireServer(self, "Sell", ...)
            end
        end
        return oldNamecall(self, ...)
    end))
    hookSuccess = true
    queueLog("Hook: hookmetamethod aktif")
elseif hookfunction and newcclosure and getrawmetatable then
    local mt = getrawmetatable(game)
    oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "fireServer") and isRecording then
            if self == TowerAdd then handleFireServer(self, "Place", ...)
            elseif self == TowerUpgrade then handleFireServer(self, "Upgrade", ...)
            elseif self == TowerSell then handleFireServer(self, "Sell", ...)
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
    hookSuccess = true
    queueLog("Hook: getrawmetatable aktif")
end

if not hookSuccess then
    local remotes = {
        { remote = TowerAdd,     actionType = "Place" },
        { remote = TowerUpgrade, actionType = "Upgrade" },
        { remote = TowerSell,    actionType = "Sell" },
    }
    for _, entry in ipairs(remotes) do
        local rawFire = entry.remote.FireServer
        entry.remote.FireServer = function(self, ...)
            if isRecording then handleFireServer(self, entry.actionType, ...) end
            return rawFire(self, ...)
        end
    end
    queueLog("WARN: Pakai fallback hook")
end

-- Hook TAMBAHAN: saat TIDAK recording, kita juga mau tau Id↔placeIndex untuk MAPPING
-- dengan cara menangkap respon server saat recording.
-- (Dilakukan dengan OnClientEvent di atas, tapi hanya bermanfaat jika kita tau
--  urutan Place saat record.)

-- --------------------------------------------------------------------
-- PLAYBACK
-- --------------------------------------------------------------------
local MIN_INTERVAL = 0.2

local remoteByName = {
    ["TowerAdd"] = TowerAdd,
    ["TowerUpgrade"] = TowerUpgrade,
    ["TowerSell"] = TowerSell,
}

local function waitForPlaceResponse(timeout)
    timeout = timeout or 3

    -- Cek pending dulu (kalau server balas duluan)
    if #pendingPlaceResponses > 0 then
        return table.remove(pendingPlaceResponses, 1)
    end

    local w = {resolved = false, id = nil, unitId = nil}
    table.insert(placeResponseWaiters, w)

    local t0 = os.clock()
    while not w.resolved and (os.clock() - t0) < timeout do
        task.wait(0.05)
    end

    if not w.resolved then
        -- Timeout, hapus waiter
        for i, x in ipairs(placeResponseWaiters) do
            if x == w then table.remove(placeResponseWaiters, i) break end
        end
        return nil
    end
    return w
end

local function playMacro()
    if isPlaying then return end
    if #recordedActions == 0 then
        queueLog("ERROR: Tidak ada data rekam!")
        return
    end

    isPlaying = true
    StatusLabel.Text = "Status: PLAYING..."
    StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
    queueLog(string.format("PLAYBACK STARTED: %d aksi", #recordedActions))

    task.spawn(function()
        -- Reset state playback
        newServerIdByPlaceIndex = {}
        pendingPlaceResponses = {}
        placeResponseWaiters = {}

        -- PENTING: Restart counter place supaya konsisten
        local playPlaceCounter = 0

        local playStartTime = os.clock()
        local lastFire = 0

        for index, action in ipairs(recordedActions) do
            if not isPlaying then break end

            -- Timing
            local targetTime = action.time
            local currentElapsed = os.clock() - playStartTime
            local waitDuration = targetTime - currentElapsed
            if waitDuration > 0 then task.wait(waitDuration) end

            local sinceLast = os.clock() - lastFire
            if sinceLast < MIN_INTERVAL then task.wait(MIN_INTERVAL - sinceLast) end

            if not isPlaying then break end

            local remote = remoteByName[action.remoteName] or action.remote
            local fireArgs = copyArgs(action.args, action.argCount)

            local rawFn = rawFireServer[remote] or remote.FireServer

            if action.actionType == "Place" then
                playPlaceCounter = playPlaceCounter + 1
                local myPlaceIndex = playPlaceCounter

                local sentUnitId
                if type(fireArgs[1]) == "table" and fireArgs[1].UnitId then
                    sentUnitId = fireArgs[1].UnitId
                end

                local ok, err = pcall(function()
                    rawFn(remote, table.unpack(fireArgs, 1, action.argCount))
                end)

                if ok then
                    queueLog(string.format("PLAY [%d/%d] PLACE #%d UnitId=%s",
                        index, #recordedActions, myPlaceIndex, shortId(sentUnitId)))

                    local resp = waitForPlaceResponse(3)
                    if resp and resp.id then
                        newServerIdByPlaceIndex[myPlaceIndex] = resp.id
                        queueLog(string.format("   ← server Id: %s", shortId(resp.id)))
                    else
                        queueLog(string.format("   ⚠ tidak ada respon server (timeout)"))
                    end
                else
                    queueLog(string.format("FAILED [%d] PLACE: %s", index, tostring(err)))
                end

            elseif action.actionType == "Upgrade" or action.actionType == "Sell" then
                -- Ganti Id: pakai newServerIdByPlaceIndex berdasar placeIndex
                local pIdx = action.placeIndex

                if type(fireArgs[1]) == "table" and fireArgs[1].Id then
                    local newId = pIdx and newServerIdByPlaceIndex[pIdx]
                    if newId then
                        local oldId = fireArgs[1].Id
                        fireArgs[1].Id = newId
                        queueLog(string.format("   ↪ remap Id %s -> %s (place #%d)",
                            shortId(oldId), shortId(newId), pIdx))
                    else
                        queueLog(string.format("   ⚠ tidak ada Id baru untuk place #%s (aksi dilewati)", tostring(pIdx or "?")))
                        goto continue
                    end
                end

                local ok, err = pcall(function()
                    rawFn(remote, table.unpack(fireArgs, 1, action.argCount))
                end)

                if ok then
                    queueLog(string.format("PLAY [%d/%d] %s: %s",
                        index, #recordedActions, getLabel(action.actionType),
                        describeArg(fireArgs[1])))
                else
                    queueLog(string.format("FAILED [%d] %s: %s",
                        index, getLabel(action.actionType), tostring(err)))
                end
            end

            ::continue::
            lastFire = os.clock()
        end

        isPlaying = false
        StatusLabel.Text = "Status: IDLE"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        queueLog("PLAYBACK FINISHED")
    end)
end

