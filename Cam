local LocalPlayer = Players.LocalPlayer

-- Target RemoteFunctions & RemoteEvents (Hanya remote eksekusi aksi)
local TARGET_REMOTES = {
    ["PlaceTower"]   = true,
    ["UpgradeTower"] = true,
    ["SellTower"]    = true
}

local recording          = false
local playing            = false
local autoPlayEnabled    = false
local recordedActions    = {}
local playbackSpeed      = 1.0
local currentGameSpeed   = 1.0
local currentMacroName   = "Makro 1"

local recordGameTime     = 0
local lastRecordTick     = 0

local CONFIG_FILE = "TD_Macro_Config.json"

local function log(tag, msg)
    print(string.format("[%s][MACRO][%s] %s", os.date("%H:%M:%S"), tag, msg))
end

-- Format nama file profil
local function GetFileName(profileName)
    local cleanName = string.gsub(profileName, "[%s%c%p]", "_")
    return "TD_Macro_" .. cleanName .. ".json"
end

--//========== MENCARI REMOTE DENGAN NAMA ==========
local function GetRemoteByName(name)
    for _, v in ipairs(game:GetDescendants()) do
        if v.Name == name and (v:IsA("RemoteFunction") or v:IsA("RemoteEvent")) then
            return v
        end
    end
    return nil
end

--//========== PENGATUR KECEPATAN GAME ==========
local function SetGameSpeed(speed)
    currentGameSpeed = speed
    pcall(function()
        local speedRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("SetGameSpeed")
        if speedRemote then
            speedRemote:FireServer(speed)
            log("GAME", string.format("⚡ Kecepatan game diatur ke x%.1f", speed))
        end
    end)
end

--//========== SERIALISASI DATA ==========
local function SerializeArgs(args)
    local serialized = {}
    for i, v in ipairs(args) do
        if typeof(v) == "Instance" then
            serialized[i] = {
                __type = "Instance",
                path   = v:GetFullName(),
                name   = v.Name
            }
        elseif type(v) == "table" then
            local tCopy = {}
            for k, val in pairs(v) do
                if typeof(val) == "Instance" then
                    tCopy[k] = { __type = "Instance", path = val:GetFullName(), name = val.Name }
                else
                    tCopy[k] = val
                end
            end
            serialized[i] = tCopy
        else
            serialized[i] = v
        end
    end
    return serialized
end

local function ResolveInstance(data)
    if type(data) == "table" and data.__type == "Instance" then
        local obj = workspace
        for segment in string.gmatch(data.path, "[^.]+") do
            if segment ~= "Workspace" and segment ~= "game" then
                obj = obj:FindFirstChild(segment)
                if not obj then break end
            end
        end
        return obj or workspace:FindFirstChild(data.name, true)
    end
    return data
end

local function DeserializeArgs(args)
    local deserialized = {}
    for i, v in ipairs(args) do
        if type(v) == "table" then
            if v.__type == "Instance" then
                deserialized[i] = ResolveInstance(v)
            else
                local tCopy = {}
                for k, val in pairs(v) do
                    tCopy[k] = ResolveInstance(v)
                end
                deserialized[i] = tCopy
            end
        else
            deserialized[i] = v
        end
    end
    return deserialized
end

--//========== SISTEM SAVING CONFIG & FILE ==========
local function SaveConfig()
    if not writefile then return end
    pcall(function()
        local cfg = {
            autoPlay         = autoPlayEnabled,
            lastMacroName    = currentMacroName,
            playbackSpeed    = playbackSpeed,
            currentGameSpeed = currentGameSpeed
        }
        writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
        log("CONFIG", "💾 Konfigurasi makro berhasil diperbarui.")
    end)
end

local function LoadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if data then
            if data.autoPlay ~= nil then autoPlayEnabled = data.autoPlay end
            if data.lastMacroName then currentMacroName = data.lastMacroName end
            if data.playbackSpeed then playbackSpeed = data.playbackSpeed end
            if data.currentGameSpeed then currentGameSpeed = data.currentGameSpeed end
            log("CONFIG", "📂 Konfigurasi tersimpan berhasil dimuat.")
        end
    end)
end

local function SaveMacroToFile(name)
    if #recordedActions == 0 then
        return log("SAVE", "⚠️ Tidak ada aksi untuk disimpan!")
    end
    if not writefile then
        return log("SAVE", "❌ Executor tidak mendukung writefile!")
    end

    local fileName = GetFileName(name)
    local cleanActions = {}
    for _, act in ipairs(recordedActions) do
        table.insert(cleanActions, {
            remoteName = act.remoteName,
            args       = act.args,
            gameTime   = act.gameTime
        })
    end

    local ok, err = pcall(function()
        writefile(fileName, HttpService:JSONEncode(cleanActions))
    end)

    if ok then
        log("SAVE", string.format("💾 Profil '%s' disimpan ke '%s' (%d aksi)", name, fileName, #recordedActions))
        SaveConfig()
    else
        log("SAVE", "❌ Gagal menyimpan file makro: " .. tostring(err))
    end
end

local function LoadMacroFromFile(name)
    if not readfile or not isfile then
        return log("LOAD", "❌ Executor tidak mendukung readfile/isfile!")
    end

    local fileName = GetFileName(name)
    if not isfile(fileName) then
        return log("LOAD", "⚠️ File makro '" .. fileName .. "' tidak ditemukan!")
    end

    local okParse, parsedData = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)

    if okParse and type(parsedData) == "table" then
        recordedActions = {}
        for _, act in ipairs(parsedData) do
            table.insert(recordedActions, {
                remote     = GetRemoteByName(act.remoteName),
                remoteName = act.remoteName,
                args       = act.args,
                gameTime   = act.gameTime or act.time or 0
            })
        end
        log("LOAD", string.format("📂 Profil '%s' dimuat (%d aksi)", name, #recordedActions))
        return true
    else
        log("LOAD", "❌ Gagal membaca file makro!")
        return false
    end
end

--//========== PROSES PLAYBACK TERURUT ==========
local function StartPlayback()
    if recording or #recordedActions == 0 or playing then return end
    playing = true

    task.spawn(function()
        log("PLAY", string.format("▶ Memulai '%s' [Strict Sequential & Continuous Retry Active]...", currentMacroName))

        local playElapsedGameTime = 0
        local lastPlayTick = tick()

        for i, act in ipairs(recordedActions) do
            if not playing then break end

            local targetGameTime = act.gameTime

            while playing do
                local now = tick()
                local dt = now - lastPlayTick
                lastPlayTick = now

                local effectiveSpeed = currentGameSpeed * playbackSpeed
                playElapsedGameTime = playElapsedGameTime + (dt * effectiveSpeed)

                local remainingGameTime = targetGameTime - playElapsedGameTime
                if remainingGameTime <= 0 then break end

                local realWait = remainingGameTime / effectiveSpeed
                task.wait(math.min(realWait, 0.03))
            end

            if not playing then break end

            local actionSuccess = false
            local retryAttempts = 0

            -- Perbaikan: Loop retry terus berjalan sampai sukses (tidak di-skip)
            repeat
                if not playing then break end

                local remoteObj = act.remote or GetRemoteByName(act.remoteName)
                if remoteObj then
                    local realArgs = DeserializeArgs(act.args)
                    
                    local ok, response = pcall(function()
                        return remoteObj:InvokeServer(unpack(realArgs))
                    end)

                    if ok then
                        if response == false then
                            actionSuccess = false
                        elseif type(response) == "table" and response.Success == false then
                            actionSuccess = false
                        else
                            actionSuccess = true
                        end
                    else
                        actionSuccess = false
                    end
                end

                if not actionSuccess then
                    retryAttempts = retryAttempts + 1
                    log("PLAY", string.format("⚠️ Aksi [%d/%d] '%s' belum berhasil (Vote/Cooldown/Uang). Mencoba ulang #%d...", 
                        i, #recordedActions, act.remoteName, retryAttempts))
                    task.wait(0.4 / (currentGameSpeed * playbackSpeed))
                end
            until actionSuccess or not playing

            if actionSuccess then
                log("PLAY", string.format("✅ [%d/%d] Berhasil: %s", i, #recordedActions, act.remoteName))
            end
        end

        playing = false
        log("PLAY", "✅ Playback Makro Selesai.")
    end)
end

